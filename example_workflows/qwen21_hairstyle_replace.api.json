      ],
      "negative": [
        "7",
        1
      ],
      "latent_image": [
        "7",
        2
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler - 固定种子25步替换人物发型"
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {

{
  "HairstyleGallery": {
    "display_name": "Hairstyle Gallery 发型图库",
    "description": "浏览内置发型或上传自定义参考图，支持中英文名称与PNG输出。",
    "inputs": {
      "hairstyle_id": {
        "name": "发型编号",
        "tooltip": "从图库选择假人发型，不会自动运行工作流。"
      },
      "language": {
        "name": "界面与文本语言",
        "tooltip": "zh：中文；en：English。切换名称、描述和发型长度。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "宽度"
      },
      "2": {
        "name": "高度"
      },
      "3": {
        "name": "发型编号"
      },
      "4": {
        "name": "名称"
      },
      "5": {
        "name": "描述"
      },
      "6": {
        "name": "发型长度"
      },
      "7": {
        "name": "来源编号"
      }
    }
  },
  "RandomHairstyleGallery": {
    "display_name": "Random Hairstyle Gallery 随机发型图库",
    "description": "每次运行自动从可用素材中抽取发型，不改变原发型图库节点。",
    "inputs": {
      "origin": {
        "name": "随机来源",
        "tooltip": "all：全部；builtin：内置；user：自定义。"
      },
      "language": {
        "name": "界面与文本语言",
        "tooltip": "zh：中文；en：English。切换名称、描述和发型长度。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "宽度"
      },
      "2": {
        "name": "高度"
      },
      "3": {
        "name": "发型编号"
      },
      "4": {
        "name": "名称"
      },
      "5": {
        "name": "描述"
      },
      "6": {
        "name": "发型长度"
      },
      "7": {
        "name": "来源编号"
      }
    }
  }
}
